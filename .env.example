# 이 파일을 복사해 .env.local 을 만든다. .env* 는 커밋 금지.
# NEXT_PUBLIC_ 접두어가 붙은 값만 브라우저에 노출된다. 서버 시크릿에는 절대 붙이지 않는다.

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=                 # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon(publishable) 키. RLS 가 보호하므로 브라우저 노출 OK
SUPABASE_SERVICE_ROLE_KEY=                # 서버 전용. 결제 확정·웹훅에서 RLS 우회. 절대 브라우저 금지

# ----- 포트원 V2 (PG: 토스페이먼츠) -----
NEXT_PUBLIC_PORTONE_STORE_ID=             # 콘솔 > 상점 ID (store-...)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=          # 콘솔 > 결제 연동 > 토스페이먼츠 채널 키 (channel-key-...)
PORTONE_API_SECRET=                       # 콘솔 > API Secret (V2). 서버 전용
PORTONE_WEBHOOK_SECRET=                   # 콘솔 > 웹훅 > 시크릿 (whsec_...). 웹훅 URL: {APP_URL}/api/webhooks/portone
APP_ENCRYPTION_KEY=                       # 32자 이상 임의 문자열. 빌링키 암호화용

# ----- 앱 -----
APP_URL=http://localhost:3000
# 로컬에서 포트원 키 없이 결제 흐름을 시험할 때만 true. 운영에서는 반드시 비운다 (NODE_ENV=production 이면 무시됨).
PAYMENTS_MOCK=true

# ----- AI (Claude API) -----
# 비워 두면 AI 를 부르지 않는다: 디자인 유형 · 벤치마킹 · 템플릿 · AI 작업 지시서 화면은 그대로 쓰고, AI 반영 요청은 담당자가 처리한다.
# 키 발급: https://console.anthropic.com → API Keys. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다.
ANTHROPIC_API_KEY=
# 하루 전체 AI 비용 상한 (USD). 넘으면 AI 처리를 멈추고 담당자에게 넘긴다. 비우면 30
AI_DAILY_BUDGET_USD=
# off 로 두면 키가 있어도 AI 를 부르지 않는다 (점검 · 비상 정지용)
AI_ENGINE=

# ----- 사이트 전용 Supabase 프로젝트 (관리자 목록 · 관리자 페이지) -----
# 고객이 사이트를 만들면 그 사이트만 쓰는 Supabase 프로젝트를 관리 API 로 만든다. 비워 두면 만들지 않는다.
# 토큰: Supabase 대시보드 > Account > Access Tokens. 범위 제한 토큰이면 리소스 = 조직 전체, 권한 = Full access (프로젝트 하나만 고르면 새 프로젝트를 못 만든다).
# 서버 전용. APP_ENCRYPTION_KEY(32자 이상)도 있어야 한다 (키를 암호화해 둔다).
# 무료 조직은 계정당 2개까지라 운영에서는 조직을 Pro 로 올려야 한다 (프로젝트마다 Micro 약 $10/월).
SUPABASE_ACCESS_TOKEN=
# 프로젝트를 만들 조직 slug (비우면 앱 메인 프로젝트가 있는 조직) · 지역 (비우면 서울 ap-northeast-2)
SUPABASE_SITES_ORG=
SUPABASE_SITES_REGION=
# off 로 두면 토큰이 있어도 만들지 않는다
SITE_DB=
